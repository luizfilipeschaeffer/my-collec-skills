# Database
# Local Docker: postgresql://mcs:mcs@localhost:5432/my_collec_skills?schema=public
# Produção / Vercel: Neon connection string (use pooler em serverless)
# Ver docs/DEPLOY.md — nunca commitar a URL real
DATABASE_URL="postgresql://mcs:mcs@localhost:5432/my_collec_skills?schema=public"

# Auth.js — gere com: pnpm exec auth secret
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"

# OAuth GitHub — https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# OAuth GitLab — https://gitlab.com/-/user_settings/applications
# Callback: http://localhost:3000/api/auth/callback/gitlab
# Scopes: read_user openid profile email
# AUTH_GITLAB_ID=
# AUTH_GITLAB_SECRET=

# CLI / extensão (URL da Profile API)
MCS_API_URL="http://localhost:3000"

# true = usa usuário seed "demo" sem OAuth (somente em development)
MCS_DEMO_MODE="false"

# skills.sh API v1 — Vercel OIDC (apps/web)
# Project → Settings → OIDC Federation → ON
# Local: cd apps/web && vercel link && vercel env pull
# Sem token: fallback para /api/search legado
# VERCEL_OIDC_TOKEN=
