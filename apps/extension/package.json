{
  "name": "mcs-extension",
  "displayName": "My Collec Skills Marketplace",
  "description": "Busque e instale skills, agents, MCPs, docs, profiles e coleções no workspace — Cursor, VS Code e Trae.",
  "version": "0.3.0",
  "publisher": "my-collec-skills",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luizfilipeschaeffer/my-collec-skills.git"
  },
  "homepage": "https://github.com/luizfilipeschaeffer/my-collec-skills/tree/main/apps/extension#readme",
  "bugs": {
    "url": "https://github.com/luizfilipeschaeffer/my-collec-skills/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mcs",
    "skills",
    "marketplace",
    "cursor",
    "vscode",
    "trae",
    "mcp",
    "agents",
    "profile"
  ],
  "activationEvents": [
    "onView:mcs.sidebar",
    "onWebviewPanel:mcs.marketplace",
    "onCommand:mcs.openMarketplace",
    "onCommand:mcs.searchCatalog",
    "onCommand:mcs.installCatalogItem",
    "onCommand:mcs.installProfile",
    "onCommand:mcs.manageCollections",
    "onCommand:mcs.login",
    "onCommand:mcs.logout",
    "onCommand:mcs.refresh"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "title": "My Collec Skills",
      "properties": {
        "mcs.apiUrl": {
          "type": "string",
          "default": "https://my-collec-skills.vercel.app",
          "description": "Base URL da API MCS (sem barra final)."
        },
        "mcs.ideTarget": {
          "type": "string",
          "enum": ["auto", "cursor", "vscode", "both"],
          "default": "auto",
          "description": "Layout de apply: auto detecta Cursor vs VS Code/Trae/outros; both aplica os dois layouts."
        }
      }
    },
    "commands": [
      {
        "command": "mcs.openMarketplace",
        "title": "MCS: Open Marketplace",
        "icon": "$(window)"
      },
      {
        "command": "mcs.searchCatalog",
        "title": "MCS: Search Catalog",
        "icon": "$(search)"
      },
      {
        "command": "mcs.installCatalogItem",
        "title": "MCS: Install Catalog Item",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcs.installProfile",
        "title": "MCS: Install Profile",
        "icon": "$(repo)"
      },
      {
        "command": "mcs.manageCollections",
        "title": "MCS: Manage Collections",
        "icon": "$(library)"
      },
      {
        "command": "mcs.login",
        "title": "MCS: Login",
        "icon": "$(sign-in)"
      },
      {
        "command": "mcs.logout",
        "title": "MCS: Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "mcs.refresh",
        "title": "MCS: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcs",
          "title": "MCS",
          "icon": "media/mcs.svg"
        }
      ]
    },
    "views": {
      "mcs": [
        {
          "id": "mcs.sidebar",
          "name": "Marketplace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mcs.openMarketplace",
          "when": "view == mcs.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "mcs.refresh",
          "when": "view == mcs.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "mcs.installProfile",
          "when": "view == mcs.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "mcs.login",
          "when": "view == mcs.sidebar",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "mcs.openMarketplace",
          "when": "true"
        },
        {
          "command": "mcs.searchCatalog",
          "when": "true"
        },
        {
          "command": "mcs.installCatalogItem",
          "when": "true"
        },
        {
          "command": "mcs.refresh",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build -- --production"
  },
  "dependencies": {
    "my-collec-skills-apply-engine": "workspace:*",
    "my-collec-skills-manifest": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
