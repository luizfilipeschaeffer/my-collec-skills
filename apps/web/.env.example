# Copie para .env.local: Copy-Item .env.example .env.local
DATABASE_URL="postgresql://mcs:mcs@localhost:5432/my_collec_skills?schema=public"

AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
MCS_API_URL="http://localhost:3000"

# OAuth — crie em https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# OAuth GitLab — https://gitlab.com/-/user_settings/applications
# Callback: http://localhost:3000/api/auth/callback/gitlab
# Scopes: read_user openid profile email
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=

# true = usa usuário seed "demo" sem OAuth (somente em development)
MCS_DEMO_MODE="false"

# skills.sh API v1 — autenticação via Vercel OIDC
# 1) No dashboard Vercel: Project → Settings → OIDC Federation → ON
# 2) Local: vercel link (em apps/web) && vercel env pull
# Sem token, o catálogo cai no endpoint legado /api/search.
# VERCEL_OIDC_TOKEN=
