{
  "name": "@mcs/manifest",
  "version": "0.1.0",
  "description": "Zod schemas and types for MCS Profile Manifest v1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizfilipeschaeffer/my-collec-skills.git",
    "directory": "packages/manifest"
  },
  "homepage": "https://github.com/luizfilipeschaeffer/my-collec-skills/tree/main/packages/manifest#readme",
  "bugs": {
    "url": "https://github.com/luizfilipeschaeffer/my-collec-skills/issues"
  },
  "keywords": [
    "mcs",
    "my-collec-skills",
    "manifest",
    "zod",
    "cursor",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
