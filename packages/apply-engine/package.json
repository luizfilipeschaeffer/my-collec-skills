{
  "name": "my-collec-skills-apply-engine",
  "version": "0.1.1",
  "description": "Apply a validated MCS Profile Manifest to a local workspace",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "my-collec-skills-manifest": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizfilipeschaeffer/my-collec-skills.git",
    "directory": "packages/apply-engine"
  },
  "homepage": "https://github.com/luizfilipeschaeffer/my-collec-skills/tree/main/packages/apply-engine#readme",
  "bugs": {
    "url": "https://github.com/luizfilipeschaeffer/my-collec-skills/issues"
  },
  "keywords": [
    "mcs",
    "my-collec-skills",
    "apply",
    "cursor",
    "skills",
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
