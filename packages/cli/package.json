{
  "name": "my-collec-skills",
  "version": "0.1.1",
  "description": "My Collec Skills CLI — install profiles locally",
  "type": "module",
  "bin": {
    "mcs": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "my-collec-skills-apply-engine": "workspace:*",
    "my-collec-skills-manifest": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizfilipeschaeffer/my-collec-skills.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/luizfilipeschaeffer/my-collec-skills/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/luizfilipeschaeffer/my-collec-skills/issues"
  },
  "keywords": [
    "mcs",
    "my-collec-skills",
    "cursor",
    "skills",
    "mcp",
    "cli",
    "bun"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
